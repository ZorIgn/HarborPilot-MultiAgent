HARBOR_AGENT_OPENAI_API_KEY=
HARBOR_AGENT_LLM_MODE=mock
HARBOR_AGENT_LLM_PROVIDER=mock
HARBOR_AGENT_OPENAI_MODEL=gpt-4.1-mini
HARBOR_AGENT_OPENAI_BASE_URL=
HARBOR_AGENT_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
HARBOR_AGENT_ADMIN_TOKEN=

# Optional Langfuse observability (server-side only; install .[observability] first)
HARBOR_AGENT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_SAMPLE_RATE=1

# Real OpenAI-compatible mode:
# HARBOR_AGENT_LLM_MODE=openai
# HARBOR_AGENT_LLM_PROVIDER=openai
# HARBOR_AGENT_OPENAI_MODEL=gpt-4.1-mini
# HARBOR_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
#
# DeepSeek-compatible mode:
# HARBOR_AGENT_LLM_MODE=openai
# HARBOR_AGENT_LLM_PROVIDER=deepseek
# HARBOR_AGENT_OPENAI_MODEL=deepseek-chat
