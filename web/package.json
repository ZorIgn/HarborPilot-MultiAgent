{
  "name": "harbor-pilot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set NEXT_DIST_DIR=next-dev&& next dev -p 3001",
    "build": "set NEXT_DIST_DIR=next-build&& set NEXT_TELEMETRY_DISABLED=1&& set NEXT_IGNORE_INCORRECT_LOCKFILE=1&& set NEXT_TRACE_SPAN_THRESHOLD_MS=2147483647&& next build",
    "start": "set NEXT_DIST_DIR=next-build&& next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "animal-island-ui": "^1.0.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
