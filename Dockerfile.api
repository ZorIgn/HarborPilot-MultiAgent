FROM python:3.12-slim

WORKDIR /app
ENV PYTHONPATH=/app/src

COPY requirements.txt requirements-observability.txt pyproject.toml ./
RUN pip install --no-cache-dir -r requirements.txt

ARG INSTALL_OBSERVABILITY=false
RUN if [ "$INSTALL_OBSERVABILITY" = "true" ]; then \
      pip install --no-cache-dir -r requirements-observability.txt; \
    fi

COPY src ./src
COPY data ./data
COPY examples ./examples

EXPOSE 8000
CMD ["uvicorn", "harbor_agent.app:app", "--host", "0.0.0.0", "--port", "8000"]
